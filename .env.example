# Environment Variables Example

# Server configuration
PORT=3001

# MongoDB Configuration
MONGO_URI="your_mongodb_connection_string"

# Authentication
JWT_SECRET="your_jwt_secret"

# --------------------------
# External Integrations
# --------------------------

# NASA FIRMS (Fire Information for Resource Management System)
# Free registration required to get a key
NASA_FIRMS_MAP_KEY="your_nasa_firms_key_here"

# The following services are currently integrated and are 100% free with no keys required:
# - Open-Meteo (Climate data)
# - RestCountries (Regional Data)
# - Open-Elevation (Topography)
